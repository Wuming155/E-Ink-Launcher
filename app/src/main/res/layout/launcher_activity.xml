<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.wuming.einklauncher.widgets.EInkLauncherView
        android:id="@+id/mList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"></com.wuming.einklauncher.widgets.EInkLauncherView>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.7dp"
        android:background="#000000" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="45dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:visibility="visible">

            <TextView
                android:id="@+id/pageStatus"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#000000"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/textClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#000000"
                android:textSize="16sp"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="8dp"
                android:layout_marginEnd="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.wuming.einklauncher.widgets.BatteryView
                    android:id="@+id/batteryProgress"
                    android:layout_width="22dp"
                    android:layout_height="12dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/batteryPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginStart="4dp"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    tools:text="85%" />

                <TextView
                    android:id="@+id/batteryStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginStart="4dp"
                    android:text="@string/battery_charging"
                    android:textColor="#000000"
                    android:textSize="12sp" />
            </LinearLayout>


            <ImageView
                android:id="@+id/toSetting"
                android:layout_width="60dp"
                android:layout_height="45dp"
                android:background="?android:selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/launcher_settings"
                android:padding="10dp"
                android:src="@drawable/navibar_icon_settings_highlight" />

            <Button
                android:id="@+id/lastPage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/previous_page"
                android:visibility="gone" />

            <Button
                android:id="@+id/nextPage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/next_page"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/deleteFinish"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/app_manager_finish"
            android:textSize="18sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>